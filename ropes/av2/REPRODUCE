#!/usr/bin/env bash
# Rope AV2: one command, from the rope directory, on Linux (Landlock kernel, non-root user; elan, git,
# Go >= 1.24 and sha256sum on PATH):
#   bash REPRODUCE
# Preflight: tools present; every file matches MANIFEST; the challenges' definitions are OpenAI's
# challenge text verbatim; the one adapted OpenAI lemma differs from OpenAI's only by 5 -> 6. Then it
# builds pinned Comparator, lean4export and landrun for the rope's toolchain, fetches the Mathlib
# cache, builds the rope (OpenAI's EuclideanRamsey sources, about 20 min to 2.5 h the first time, depending on machine load), prints
# the axioms of the seven checked theorems, and runs stock Comparator on the 5 challenges (OpenAI's
# own circle and spherical challenges and the rope's three; each must print "Your solution is
# okay") and the 5 controls (each must be refused with its expected reason). Exit 0 iff all of that
# behaves.
# Tools go to $AV2_TOOLS (default ./.lake/av2-tools); logs go to ./.lake/av2-logs.
# Optional: AV2_UPSTREAM=1 also re-fetches openai/math at the pinned commit and compares the
# vendored OAI/ tree and challenge files with it byte for byte.
set -u
cd "$(dirname "$0")"
step() { echo "[$(date -u +%H:%M:%S)] $*"; }
die() { echo "REPRODUCE: $*" >&2; exit 2; }

step "preflight: tools"
command -v elan >/dev/null || die "elan not found on PATH (install: https://github.com/leanprover/elan)"
command -v lake >/dev/null || die "lake not found on PATH (it comes with elan: add ~/.elan/bin to PATH)"
command -v git >/dev/null || die "git not found on PATH"
command -v go >/dev/null || die "Go not found on PATH (https://go.dev/dl/, version 1.24 or later; needed for landrun)"
command -v sha256sum >/dev/null || die "sha256sum not found on PATH (coreutils)"
[ "$(uname -s)" = Linux ] || die "Comparator's sandbox (landrun) needs Linux with Landlock"
[ "$(id -u)" != 0 ] || die "run as a non-root user (Comparator's README)"
if [ -r /sys/kernel/security/lsm ] && ! grep -q landlock /sys/kernel/security/lsm; then
  die "Landlock is not enabled (/sys/kernel/security/lsm does not list landlock)"
fi

step "preflight: MANIFEST"
grep -v '^#' MANIFEST | sha256sum --quiet -c - || die "a file differs from MANIFEST"

step "preflight: challenge definitions are OpenAI's verbatim"
OAIDIR=OAI/Combinatorics/EuclideanRamsey
CIRCLE=vendor/OAI-ComparatorChallenge-EuclideanRamseyCircle.lean
SPHER=vendor/OAI-ComparatorChallenge-EuclideanRamseySpherical.lean
ramsey_end='Congruent a b ∧ ∃ k : Fin r, ∀ i, c (b i) = k$'
defs() { sed -n "/^abbrev Space/,/$ramsey_end/p" "$1"; }     # Space, Congruent, Ramsey
head_() { sed -n "/^namespace OAI\$/,/$ramsey_end/p" "$1"; }  # preamble and definitions
for f in AV2Challenge/Main.lean AV2Challenge/Equiv.lean \
         AV2Control/SorryMain.lean AV2Control/AxiomMain.lean AV2Control/WeakerMain.lean; do
  [ -n "$(defs "$f")" ] || die "$f: no Space/Congruent/Ramsey block found"
  for ref in "$CIRCLE" "$SPHER" "$OAIDIR/Model.lean"; do
    cmp -s <(defs "$f") <(defs "$ref") || die "$f: Space/Congruent/Ramsey differ from $ref"
  done
  for ref in "$SPHER" "$OAIDIR/Model.lean"; do
    cmp -s <(head_ "$f") <(head_ "$ref") || die "$f: preamble and definitions differ from $ref"
  done
done
echo "  Space, Congruent, Ramsey: identical to OpenAI's two challenge files and to OAI/.../Model.lean"
cmp -s AV2Challenge/OAICircle.lean "$CIRCLE" \
  || die "AV2Challenge/OAICircle.lean is not OpenAI's EuclideanRamseyCircle challenge byte for byte"
cmp -s AV2Challenge/OAISpherical.lean "$SPHER" \
  || die "AV2Challenge/OAISpherical.lean is not OpenAI's EuclideanRamseySpherical challenge byte for byte"
echo "  AV2Challenge/OAICircle.lean, OAISpherical.lean: OpenAI's challenges, byte for byte"

step "preflight: extend_to_six is OpenAI's extend_to_five with 5 replaced by 6"
block() { sed -n "/^theorem $1/,/^    simp \[b, f\]\$/p" "$2"; }
[ -n "$(block extend_to_six Rope/SixPointCircle.lean)" ] || die "extend_to_six not found"
cmp -s <(block extend_to_five "$OAIDIR/CircleExtension.lean" | sed 's/extend_to_five/extend_to_six/; s/5/6/g') \
       <(block extend_to_six Rope/SixPointCircle.lean) \
  || die "Rope/SixPointCircle.lean: extend_to_six is not extend_to_five with 5 -> 6"
echo "  identical after the substitution"

TOOLCHAIN=$(cat lean-toolchain)                           # leanprover/lean4:v4.34.1
OAI_COMMIT=fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb       # openai/math, the vendored release
COMPARATOR_REV=d03acab154d269c06e60e4de7e4cc85deebff94b   # leanprover/comparator tag v4.34.0
LEAN4EXPORT_REV=076e8e57707e813375e8f9da8bf989799ace9680  # leanprover/lean4export tag v4.34.0
LANDRUN_REV=811cfff51ceaf3d9843708aa6d22e9b84ccac8b4      # Zouuup/landrun main, as Comparator's README asks
T=${AV2_TOOLS:-$PWD/.lake/av2-tools}
LOGS=$PWD/.lake/av2-logs
mkdir -p "$T/src" "$T/bin" "$LOGS"

if [ "${AV2_UPSTREAM:-0}" = 1 ]; then
  step "upstream: fetching openai/math $OAI_COMMIT (sparse) and comparing the vendored files"
  up=$(mktemp -d)
  ( git -C "$up" init -q && git -C "$up" config core.autocrlf false \
    && git -C "$up" remote add origin https://github.com/openai/math.git \
    && git -C "$up" sparse-checkout set --no-cone lean/OAI/Combinatorics/EuclideanRamsey \
         lean/ComparatorChallenges/EuclideanRamseyCircle.lean \
         lean/ComparatorChallenges/EuclideanRamseySpherical.lean /LICENSE \
    && git -C "$up" fetch -q --depth 1 --filter=blob:none origin "$OAI_COMMIT" \
    && git -C "$up" checkout -q FETCH_HEAD ) || die "fetching openai/math failed"
  diff -r "$up/lean/OAI/Combinatorics/EuclideanRamsey" "$OAIDIR" >/dev/null \
    || die "$OAIDIR differs from openai/math $OAI_COMMIT"
  cmp -s "$up/LICENSE" vendor/OAI-LICENSE || die "vendor/OAI-LICENSE differs from upstream"
  cmp -s "$up/lean/ComparatorChallenges/EuclideanRamseyCircle.lean" "$CIRCLE" \
    || die "$CIRCLE differs from upstream"
  cmp -s "$up/lean/ComparatorChallenges/EuclideanRamseySpherical.lean" "$SPHER" \
    || die "$SPHER differs from upstream"
  rm -rf "$up"
  echo "  vendored OAI sources, LICENSE and both challenge files are byte-identical to upstream"
fi

step "fetching comparator, lean4export, landrun"
for spec in "comparator https://github.com/leanprover/comparator.git $COMPARATOR_REV" \
            "lean4export https://github.com/leanprover/lean4export.git $LEAN4EXPORT_REV" \
            "landrun https://github.com/Zouuup/landrun.git $LANDRUN_REV"; do
  set -- $spec
  [ -d "$T/src/$1" ] || git clone --quiet "$2" "$T/src/$1" || die "cloning $1 failed"
  git -C "$T/src/$1" checkout --quiet "$3" || die "checking out $1 $3 failed"
done
# No v4.34.1 tag exists for comparator or lean4export: build the v4.34.0 sources with the rope's toolchain.
for t in comparator lean4export; do
  step "building $t with $TOOLCHAIN"
  echo "$TOOLCHAIN" > "$T/src/$t/lean-toolchain"
  (cd "$T/src/$t" && lake build "$t" >"$LOGS/build-$t.log" 2>&1) || die "building $t failed (see $LOGS/build-$t.log)"
  ln -sf "$T/src/$t/.lake/build/bin/$t" "$T/bin/$t"
done
step "building landrun"
(cd "$T/src/landrun" && go build -o "$T/bin/landrun" cmd/landrun/main.go) >"$LOGS/build-landrun.log" 2>&1 \
  || die "building landrun failed (see $LOGS/build-landrun.log)"
export PATH="$T/bin:$PATH"

step "fetching the Mathlib cache"
lake exe cache get >"$LOGS/cache.log" 2>&1 || die "lake exe cache get failed (see $LOGS/cache.log)"
step "building the rope: OAI sources, solution, challenges, controls (first time: about 20 min to 2.5 h, depending on machine load)"
lake build OAI Rope AV2Challenge AV2Control >"$LOGS/build-rope.log" 2>&1 || die "rope build failed (see $LOGS/build-rope.log)"

step "axioms of the seven checked theorems"
ax=$LOGS/axioms.lean
{ echo "import Rope"
  echo "import OAI.Combinatorics.EuclideanRamsey.Circle"
  echo "import OAI.Combinatorics.EuclideanRamsey.Spherical"
  for n in OAI.EuclideanRamsey.CircleConsequence.at_most_five_circle_points_ramsey \
           OAI.EuclideanRamsey.ramsey_cospherical OAI.EuclideanRamsey.circle_ramsey_of_le_six \
           SphericalRamsey.oai_congruent_iff SphericalRamsey.oai_ramsey_iff \
           SphericalRamsey.circle_ramsey_of_le_six_mathlib SphericalRamsey.circle_ramsey_of_le_six_nonvacuous; do
    echo "#print axioms $n"; done; } > "$ax"
lake env lean "$ax" >"$LOGS/axioms.log" 2>&1 || die "printing axioms failed (see $LOGS/axioms.log)"
# Lean wraps a long "depends on axioms" line, so join lines before counting.
good=$(tr -s '\n ' '  ' < "$LOGS/axioms.log" | grep -o "depends on axioms: \[propext, Classical.choice, Quot.sound\]" | wc -l)
[ "$good" -eq 7 ] || die "expected 7 theorems on [propext, Classical.choice, Quot.sound], got $good (see $LOGS/axioms.log)"
echo "  7/7 depend on exactly [propext, Classical.choice, Quot.sound]"
# Textual backstop to the axiom check (a `sorry` quoted in backticks in a docstring is not a use).
if grep -rnwE "sorry|native_decide|ofReduceBool|admit" OAI Rope Rope.lean --include='*.lean' \
     | grep -vF '`sorry`' >"$LOGS/grep-sorry.log"; then
  die "sorry/native_decide/ofReduceBool/admit in the solution sources (see $LOGS/grep-sorry.log)"
fi
echo "  no sorry, admit, native_decide or ofReduceBool in OAI/ or Rope/"

run() {  # Comparator under systemd-run --user when available (Comparator's README), else directly
  if systemd-run --user --wait --pipe -q true 2>/dev/null; then
    systemd-run --property=RestrictAddressFamilies=~AF_UNIX --user --wait --pipe -q \
      -E PATH="$PATH" -E HOME="$HOME" --working-directory "$PWD" -- lake env comparator "$1"
  else
    lake env comparator "$1"
  fi
}
fail=0
for n in oai-circle oai-spherical main equiv mathlib; do
  step "comparator $n"
  run "comparator/$n.json" >"$LOGS/$n.log" 2>&1
  if grep -q "Your solution is okay" "$LOGS/$n.log"; then echo "  accepted  $n"
  else echo "  FAILED    $n (expected acceptance; see $LOGS/$n.log)"; fail=1; fi
done
# A control counts as refused only when Comparator ran and gave the expected reason.
for spec in "ctl-sorrymain|Illegal axiom detected: 'sorryAx'" \
            "ctl-axiommain|Illegal axiom detected: 'OAI.EuclideanRamsey.cheat'" \
            "ctl-weakermain|statement do not match: 'OAI.EuclideanRamsey.circle_ramsey_of_le_six'" \
            "ctl-redeframsey|Const does not match between challenge and target 'OAI.EuclideanRamsey.Ramsey'" \
            "ctl-weakermathlib|statement do not match: 'SphericalRamsey.circle_ramsey_of_le_six_mathlib'"; do
  n=${spec%%|*}; reason=${spec#*|}
  step "comparator $n (control)"
  run "comparator/$n.json" >"$LOGS/$n.log" 2>&1
  if grep -q "Your solution is okay" "$LOGS/$n.log"; then echo "  FAILED    $n (control accepted)"; fail=1
  elif grep -qF "$reason" "$LOGS/$n.log"; then echo "  refused   $n: $reason"
  else echo "  FAILED    $n (no expected refusal reason; see $LOGS/$n.log)"; fail=1; fi
done
[ $fail -eq 0 ] && step "all 10 as expected" || step "FAILURES above"
exit $fail
