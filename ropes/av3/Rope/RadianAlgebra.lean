import Mathlib.LinearAlgebra.Matrix.Block
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Logic.Equiv.Fin.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FinCases

/-!
# AV3, generic algebra: the radian 9-gon evaluation matrix has nonzero determinant

Theorem D of the note (`note/spherical-ramsey.tex`); `certificates/radian_det.py`. Mirrors the
specialization argument of OpenAI's `NineGridDeterminant` / `NineRationalDeterminant` (openai/math @ fd4aeeb2, Apache-2.0),
for one parameter per tensor factor instead of nine.

With `t = tan (θ/2)`, `(1 + i t)^(2n) = A_n(t) + i B_n(t)` and
`(cos nθ, sin nθ) = (A_n(t), B_n(t)) / (1 + t²)^n`. `rot z n = (A_n(z), B_n(z))`.
Everything is stated over an arbitrary commutative ring and moved by ring homomorphisms.
The determinant of the denominator-cleared matrix is certified at `(T, U) = (2, 3)` over `ℤ` by an
explicit lower-triangular `Lcert` with `Lcert * Ecl 2 3` upper triangular (kernel `decide`).
-/

namespace OAI
noncomputable section
namespace EuclideanRamsey
namespace Radian

section Generic

variable {R : Type*} [CommRing R]

/-- `rot z n = (A_n(z), B_n(z))`, the real and imaginary parts of `(1 + i z)^(2n)`. -/
def rot (z : R) : ℕ → R × R
  | 0 => (1, 0)
  | n + 1 => ((1 - z ^ 2) * (rot z n).1 - 2 * z * (rot z n).2,
      2 * z * (rot z n).1 + (1 - z ^ 2) * (rot z n).2)

/-- Denominator-cleared augmented coordinates of the `n`-th point. -/
def qv (z : R) (n : ℕ) : Fin 3 → R := ![(1 + z ^ 2) ^ n, (rot z n).1, (rot z n).2]

/-- Column labels: `j ↦ (j / 3, j % 3)`. -/
def col (j : Fin 9) : Fin 3 × Fin 3 := (finProdFinEquiv : Fin 3 × Fin 3 ≃ Fin (3 * 3)).symm j

/-- The denominator-cleared `9 × 9` tensor evaluation matrix; column `j ↔ (j / 3, j % 3)`. -/
def Ecl (z w : R) : Matrix (Fin 9) (Fin 9) R := fun k j =>
  qv z k (col j).1 * qv w k (col j).2

variable {S : Type*} [CommRing S]

theorem map_rot (f : R →+* S) (z : R) (n : ℕ) :
    f (rot z n).1 = (rot (f z) n).1 ∧ f (rot z n).2 = (rot (f z) n).2 := by
  induction n with
  | zero => simp [rot]
  | succ n ih =>
    constructor <;> simp only [rot, map_add, map_sub, map_mul, map_pow, map_one, map_ofNat, ih.1, ih.2]

theorem map_qv (f : R →+* S) (z : R) (n : ℕ) (a : Fin 3) : f (qv z n a) = qv (f z) n a := by
  fin_cases a <;> simp [qv, (map_rot f z n).1, (map_rot f z n).2]

theorem map_Ecl (f : R →+* S) (z w : R) : f.mapMatrix (Ecl z w) = Ecl (f z) (f w) := by
  ext k j
  simp [Ecl, map_qv]

end Generic

/-! ## The integer certificate at `(T, U) = (2, 3)` -/

/-- Fraction-free elimination certificate (`probes`-style; generated by exact rational
Gaussian elimination without pivoting, rows scaled to integers). -/
def Lcert : Matrix (Fin 9) (Fin 9) ℤ :=
  !![1, 0, 0, 0, 0, 0, 0, 0, 0;
  -50, 1, 0, 0, 0, 0, 0, 0, 0;
  -1500, -20, 1, 0, 0, 0, 0, 0, 0;
  -125000, -1500, 30, 1, 0, 0, 0, 0, 0;
  23750000, 160000, -7200, -160, 1, 0, 0, 0, 0;
  -434460000000, -16250770000, -210301600, 3939120, 132008, 1457, 0, 0, 0;
  18799750000000, -3839163000000, -139578810000, -1452457600, 38322120, 988428, 9937, 0, 0;
  2156500000000000, 2344809625000000, 76241622000000, 768031190000, -23776545600, -603015780,
    -5428232, 20297, 0;
  3314062500000000, -35771875000000, -1655300000000, -50915250000, 100680000, -5610100, 148320,
    3613, 127]

theorem Lcert_lower : ∀ j i : Fin 9, i < j → Lcert i j = 0 := by decide +kernel

theorem Lcert_diag : ∏ i : Fin 9, Lcert i i ≠ 0 := by decide +kernel

theorem LE_upper : ∀ i j : Fin 9, j < i → (Lcert * Ecl (2 : ℤ) 3) i j = 0 := by decide +kernel

theorem LE_diag : ∏ i : Fin 9, (Lcert * Ecl (2 : ℤ) 3) i i ≠ 0 := by decide +kernel

theorem det_Ecl_int : (Ecl (2 : ℤ) 3).det ≠ 0 := by
  have hL : Lcert.det ≠ 0 := by
    rw [Matrix.det_of_isLowerTriangular Lcert (fun i j h => Lcert_lower j i h)]
    exact Lcert_diag
  have hLE : (Lcert * Ecl (2 : ℤ) 3).det ≠ 0 := by
    rw [Matrix.det_of_isUpperTriangular (fun i j h => LE_upper i j h)]
    exact LE_diag
  rw [Matrix.det_mul] at hLE
  exact right_ne_zero_of_mul hLE

/-! ## Two independent variables -/

abbrev Poly := MvPolynomial (Unit ⊕ Unit) ℚ

def T : Poly := MvPolynomial.X (Sum.inl ())
def U : Poly := MvPolynomial.X (Sum.inr ())

/-- Evaluation at `(T, U) = (2, 3)`. -/
def ev : Poly →+* ℚ := MvPolynomial.eval (Sum.elim (fun _ => 2) (fun _ => 3))

theorem det_Ecl_poly : (Ecl T U).det ≠ 0 := by
  intro h
  have h1 : ev (Ecl T U).det = 0 := by rw [h, map_zero]
  rw [RingHom.map_det, map_Ecl] at h1
  have hT : ev T = ((2 : ℤ) : ℚ) := by simp [ev, T]
  have hU : ev U = ((3 : ℤ) : ℚ) := by simp [ev, U]
  rw [hT, hU] at h1
  have h2 : ((Int.castRingHom ℚ) (Ecl (2 : ℤ) 3).det) = 0 := by
    rw [RingHom.map_det, map_Ecl]
    simpa using h1
  exact det_Ecl_int (by simpa using h2)

theorem one_add_sq_ne_zero (v : Unit ⊕ Unit) : (1 + (MvPolynomial.X v : Poly) ^ 2) ≠ 0 := by
  intro hz
  have h := congrArg (MvPolynomial.eval (fun _ : Unit ⊕ Unit => (0 : ℚ))) hz
  norm_num at h

/-! ## The actual (uncleared) evaluation matrix in a faithful field realization -/

section Field

variable {K : Type*} [Field K]

/-- Augmented coordinates `(1, cos nθ, sin nθ)` as rational functions of `z = tan (θ/2)`. -/
def rv (z : K) (n : ℕ) : Fin 3 → K :=
  ![1, (rot z n).1 / (1 + z ^ 2) ^ n, (rot z n).2 / (1 + z ^ 2) ^ n]

/-- The tensor evaluation matrix with rows `k` and columns `(j / 3, j % 3)`. -/
def G (z w : K) : Matrix (Fin 9) (Fin 9) K := fun k j =>
  rv z k (col j).1 * rv w k (col j).2

theorem clear_rv (z : K) (hz : 1 + z ^ 2 ≠ 0) (n : ℕ) (a : Fin 3) :
    (1 + z ^ 2) ^ n * rv z n a = qv z n a := by
  have hzn : (1 + z ^ 2) ^ n ≠ 0 := pow_ne_zero n hz
  fin_cases a <;> simp [rv, qv] <;> field_simp

theorem Ecl_eq (z w : K) (hz : 1 + z ^ 2 ≠ 0) (hw : 1 + w ^ 2 ≠ 0) :
    Ecl z w = Matrix.diagonal (fun k : Fin 9 => (1 + z ^ 2) ^ (k : ℕ) * (1 + w ^ 2) ^ (k : ℕ)) *
      G z w := by
  ext k j
  rw [Matrix.diagonal_mul]
  simp only [Ecl, G, ← clear_rv z hz, ← clear_rv w hw]
  ring

theorem det_G_ne_zero (φ : Poly →+* K) (hφ : Function.Injective φ) :
    (G (φ T) (φ U)).det ≠ 0 := by
  have hden (v : Unit ⊕ Unit) : 1 + φ (MvPolynomial.X v) ^ 2 ≠ 0 := by
    intro hz
    apply one_add_sq_ne_zero v
    apply hφ
    simpa only [map_add, map_one, map_pow, map_zero] using hz
  have hE : (Ecl (φ T) (φ U)).det ≠ 0 := by
    rw [← map_Ecl, ← RingHom.map_det]
    intro h
    exact det_Ecl_poly (hφ (h.trans (map_zero φ).symm))
  intro h
  apply hE
  rw [Ecl_eq (φ T) (φ U) (hden (Sum.inl ())) (hden (Sum.inr ())), Matrix.det_mul, h, mul_zero]

end Field

end Radian
end EuclideanRamsey
end
end OAI
